---
import Layout from "../layouts/LayoutLogin.astro"
import "../styles/global.css"
---

<Layout>
    <div class="page">
        <section class="anuncios"></section>
        <section class="container">
            <h1 class="titulo">Conkort</h1>
            <div class="box">

            </div>
        </section>
    </div>
</Layout>

<style>
    *{
        padding: 0;
        margin: 0;
    }
    .page{
        overflow: hidden;
    }
    .container{
        height: 100vh;
    }
    .titulo{
        padding-top: 40px;
        padding-bottom: 20px;
        text-align: center;
    }

    .box{
        display: flex;
        height: 30rem;
        width: 50rem;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        border: solid black 2px;
        border-radius: 5px;
    }

</style>